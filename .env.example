# A dedicated PUBLIC Vercel Blob store; never expose this value to frontend code.
BLOB_READ_WRITE_TOKEN=
# Random server-only collector authorization secret.
CRON_SECRET=

# Only set a mint explicitly supplied by this project's owner.
# Manual configuration takes precedence; it is not a verified-launch claim.
TOKEN_MINT=

# Optional scheduled discovery. Leave all empty until the owner supplies this
# project's developer wallet and exact launch identity. No other wallet is reused.
DEV_WALLET=
TOKEN_EXPECTED_NAME=
TOKEN_EXPECTED_SYMBOL=
TOKEN_EXPECTED_URI=
TOKEN_WATCH_START_SLOT=
SOLANA_RPC_URL=
# Optional exact finalized launch signature for busy wallets whose complete
# history since activation cannot fit the bounded 12-signature scan.
TOKEN_LAUNCH_SIGNATURE=
